PORT=5500
APP_CACHE_TTL_SECONDS=600

# Default dashboard location
DEFAULT_CITY=Kanpur
DEFAULT_LAT=26.4499
DEFAULT_LON=80.3319

# ============================================================
# OFFICIAL INDIA METEOROLOGICAL DEPARTMENT (IMD)
# ============================================================
# Register/login: https://api.imd.gov.in/public/
# API reference:  https://api.imd.gov.in/public/api_reference.html
#
# The app uses IMD as the PRIMARY weather source when these values
# are supplied. Open-Meteo remains a supplemental/fallback source.
IMD_BASE_URL=https://api.imd.gov.in
IMD_API_KEY=
# Default assumption for token-style access.
IMD_AUTH_SCHEME=Bearer
# Keep Authorization unless IMD gives you a different header name.
# Example: X-API-Key
IMD_API_KEY_HEADER=Authorization

# IDs supplied/visible through the IMD API portal/mapping data.
# City forecast: 7-day forecast.
IMD_CITY_ID=
# Current weather station ID used by /api/v1/current_wx.
IMD_CURRENT_STATION_ID=
# District ID used by warnings/nowcast/rainfall.
IMD_DISTRICT_ID=
IMD_DISTRICT_WARNING_ID=

# ============================================================
# OPEN-METEO SUPPLEMENTAL DATA
# ============================================================
# No key required for normal use.
# Used for precipitation probability / UV / air-quality fields that
# are not part of the IMD city/current-weather response used here.

# ============================================================
# GOOGLE MAPS PLATFORM (optional, later)
# ============================================================
# Enable Places API (New) + Routes API in Google Cloud.
GOOGLE_MAPS_API_KEY=

# Never put API keys in public/app.js or HTML.
